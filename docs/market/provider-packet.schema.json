{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "competitors": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalListingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "physicalKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "identityEvidence": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "url": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri"
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "operatorName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "operatorEvidence": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -85,
                    "maximum": 85
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "longitude": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accuracyMeters": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "address": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "buildingName": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "buildingReference": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "community": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "district": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "emirate": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "postalCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "unverified",
                  "verified",
                  "approximate",
                  "synthetic"
                ]
              },
              "provider": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verifiedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidenceUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1000,
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "latitude",
              "longitude",
              "accuracyMeters",
              "address",
              "buildingName",
              "buildingReference",
              "community",
              "district",
              "city",
              "emirate",
              "country",
              "postalCode",
              "status",
              "provider",
              "verifiedAt",
              "evidenceUrl"
            ],
            "additionalProperties": false
          },
          "characteristics": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "entire_unit",
                  "private_room",
                  "hotel_room"
                ]
              },
              "rentalModel": {
                "type": "string",
                "enum": [
                  "short_term",
                  "long_term"
                ]
              },
              "bedrooms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "bathrooms": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 20
              },
              "capacity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "areaSqm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "floor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -10,
                    "maximum": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "furnishing": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "view": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewScore": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "licenseStatus": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amenities": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              },
              "accessibility": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              },
              "attractionDistances": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "distanceMeters": {
                      "type": "number",
                      "minimum": 0
                    },
                    "evidenceUrl": {
                      "type": "string",
                      "maxLength": 1000,
                      "format": "uri"
                    }
                  },
                  "required": [
                    "name",
                    "distanceMeters",
                    "evidenceUrl"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "category",
              "rentalModel",
              "bedrooms",
              "bathrooms",
              "capacity",
              "areaSqm",
              "floor",
              "furnishing",
              "condition",
              "view",
              "reviewScore",
              "reviewCount",
              "licenseStatus",
              "amenities",
              "accessibility",
              "attractionDistances"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "externalListingId",
          "physicalKey",
          "identityEvidence",
          "title",
          "url",
          "platform",
          "operatorName",
          "operatorEvidence",
          "location",
          "characteristics"
        ],
        "additionalProperties": false
      }
    },
    "offers": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "listingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "checkIn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "checkOut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "available": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "minimumStay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "cancellation": {
            "type": "string",
            "enum": [
              "flexible",
              "nonrefundable",
              "unknown"
            ]
          },
          "quoteContext": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "roomTotal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "cleaningFee": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "serviceFee": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "taxes": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "guestTotal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "allFeesKnown": {
            "type": "boolean"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "synthetic"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri"
          }
        },
        "required": [
          "observationId",
          "listingId",
          "checkIn",
          "checkOut",
          "guests",
          "available",
          "minimumStay",
          "cancellation",
          "quoteContext",
          "currency",
          "roomTotal",
          "cleaningFee",
          "serviceFee",
          "taxes",
          "guestTotal",
          "allFeesKnown",
          "observedAt",
          "verification",
          "sourceUrl"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "competitors",
    "offers"
  ],
  "additionalProperties": false
}
