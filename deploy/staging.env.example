# Separate practice environment. Never add secrets to GitHub.
APP_ENV=staging
APP_MODE=cloud
NODE_ENV=production
STAGING_PROJECT_ID=
STAGING_FIREBASE_PROJECT_ID=
STAGING_DATABASE_URL=
STAGING_RESTORE_DATABASE_URL=
STAGING_PRIVATE_BUCKET=
PRODUCTION_PROJECT_ID=
# Runtime names below must point to the SAME staging resources above.
GOOGLE_CLOUD_PROJECT=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_API_KEY=
DATABASE_URL=
PRIVATE_UPLOAD_BUCKET=
# Approved absolute scanner executable; keep ClamAV signatures fresh.
CLAMSCAN_PATH=/usr/bin/clamscan
